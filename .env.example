# Google AI Studio key (curso §4.1). GOOGLE_API_KEY tambien se acepta como alias heredado;
# si ambas estan definidas, google-genai usa GOOGLE_API_KEY.
GEMINI_API_KEY=""
# Modelo de los agentes de la fabrica; cambiar sin tocar codigo (p.ej. en saturacion:
# FACTORY_MODEL=gemini-3.8-flash-lite) - model routing bonus §28.
FACTORY_MODEL="gemini-3.8-flash"
# Otros proveedores (opcionales). Tambien se configuran desde Factory Studio > Ajustes >
# Proveedores (~/.agentic-factory/credentials.json); una variable aqui tiene prioridad.
# FACTORY_MODEL solo aplica cuando el proveedor del agente es gemini.
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# OLLAMA_HOST="http://localhost:11434"
# OPENAI_COMPATIBLE_BASE_URL="http://localhost:1234/v1"
# OPENAI_COMPATIBLE_API_KEY=""
# Do not enable Google Cloud / enterprise settings for the required path.
# GOOGLE_GENAI_USE_ENTERPRISE=true
# GOOGLE_CLOUD_PROJECT=...
# GOOGLE_CLOUD_LOCATION=...
